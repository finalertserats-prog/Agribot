# --- AI provider: set AT LEAST ONE key. The bot uses whichever is present. ---
# Google Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI — key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Optional: force a provider when both keys are set (gemini | openai).
# If unset, the bot auto-selects (prefers Gemini when both keys exist).
# LLM_PROVIDER=gemini

# Optional model overrides (defaults shown).
# GEMINI_TEXT_MODEL=gemini-2.0-flash
# GEMINI_EMBED_MODEL=text-embedding-004
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Bot trigger word (default: agrifriend)
BOT_TRIGGER=agrifriend

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Ops Copilot (optional, Phase B) ---
# Command the copilot runs to self-heal the bot when the heartbeat goes stale.
# e.g. pm2 restart agrifriend   (leave unset to alert-only, no auto-restart)
# OPS_RESTART_COMMAND=pm2 restart agrifriend
# Optional webhook (Slack/Telegram/ops channel) for alerts. NOT a WhatsApp send.
# OPS_WEBHOOK_URL=https://hooks.example.com/...

# --- WhatsApp Business Cloud API (optional — official 1:1 transport) ---
# Set ALL FOUR to enable the official Cloud transport for 1:1 chats. Leave any
# unset and the bot runs Baileys-only. Groups ALWAYS stay on Baileys (the Cloud
# API cannot serve real community groups). Get these from the Meta Developer
# dashboard: WhatsApp > API Setup.
# Permanent/temporary access token (System User token recommended for prod).
# WHATSAPP_CLOUD_TOKEN=
# The phone number's ID (NOT the phone number itself).
# WHATSAPP_PHONE_NUMBER_ID=
# A random string YOU choose; must match the "Verify token" in the Meta webhook config.
# WHATSAPP_VERIFY_TOKEN=
# App Secret (App > Settings > Basic) — used to validate X-Hub-Signature-256.
# WHATSAPP_APP_SECRET=
# Graph API version (optional, default v22.0).
# WHATSAPP_GRAPH_VERSION=v22.0
# Set "true" once 1:1 has moved to the Cloud number: Baileys then serves ONLY
# groups and ignores DMs (clean split, no chance of double-handling). Default
# (unset) keeps Baileys answering its own DMs too.
# BAILEYS_GROUPS_ONLY=false

# --- Answer depth ---
# Members are experienced growers; a cheap model produces confident, wrong
# answers about named cultivars. Default is gpt-5. "low" reasoning effort is the
# measured sweet spot (~13s vs ~57s at default, same cultivar-level accuracy).
# OPENAI_TEXT_MODEL=gpt-5
# OPENAI_REASONING_EFFORT=low

# --- Voice notes (ask in voice → text + voice note back) ---
# Requires ffmpeg on the host (OGG/Opus is what makes WhatsApp render a voice
# note rather than a file attachment). Off unless explicitly enabled.
# VOICE_ENABLED=true
# Transcription reuses OPENAI_API_KEY.
# OPENAI_STT_MODEL=gpt-4o-transcribe
# Telugu voice, best first: Sarvam (handles code-mixed Telugu-English) >
# Azure (native te-IN voice) > OpenAI (no Telugu voice; zero-setup fallback).
# Every key you set joins a fallback CHAIN, not a winner-takes-all pick: if the
# preferred vendor errors at call time (exhausted credits 402 on every request,
# not just one), the next one speaks. Keep OPENAI_API_KEY set as the last resort
# so a dead Indic vendor costs pronunciation quality, never the voice note.
# SARVAM_API_KEY=
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_SPEAKER=shubh
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
